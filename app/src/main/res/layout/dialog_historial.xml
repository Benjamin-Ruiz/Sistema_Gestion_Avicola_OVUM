<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_historial.xml
     Ubicación: res/layout/dialog_historial.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/blanco">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/tvTituloHistorial"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Historial" android:textColor="@color/verde_oscuro"
            android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <ImageButton android:id="@+id/btnCerrarHistorial" android:layout_width="32dp"
            android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
            android:tint="@color/gris_texto" android:padding="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvSinLogs" android:layout_width="match_parent"
        android:layout_height="60dp" android:gravity="center"
        android:text="Sin movimientos registrados" android:textColor="@color/gris_hint"
        android:textSize="13sp" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHistorial"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxHeight="420dp" android:nestedScrollingEnabled="true"
        android:overScrollMode="never" android:paddingHorizontal="16dp"/>

    <Space android:layout_width="match_parent" android:layout_height="16dp"/>
</LinearLayout>
