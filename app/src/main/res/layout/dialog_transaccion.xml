<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_transaccion.xml
     Ubicación: res/layout/dialog_transaccion.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Nueva Transacción"
                android:textColor="@color/verde_oscuro" android:textSize="17sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarTx" android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                app:tint="@color/gris_texto" android:padding="4dp"/>   <!-- CORREGIDO -->
        </LinearLayout>

        <!-- Selector Ingreso / Gasto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_spinner"
            android:padding="3dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTipoIngreso"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="↑ Ingreso"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/verde_oscuro"
                android:gravity="center"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <Button
                android:id="@+id/btnTipoGasto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="↓ Gasto"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/verde_oscuro"
                android:gravity="center"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

        </LinearLayout>

        <!-- Categoría -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Categoría" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Descripción -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Descripción" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcionTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences"
                android:hint="Ej: Venta de 200 pollos" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Monto -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Monto *" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMontoTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:prefixText="Q ">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMontoTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estado de pago -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Estado de Pago" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerEstado"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Monto pagado (solo si es PARCIAL) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMontoPagado" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:prefixText="Q "
            android:hint="Monto ya pagado" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMontoPagado" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contacto (cliente o proveedor) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cliente / Proveedor" android:textSize="13sp"
            android:textColor="@color/gris_texto" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactoTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactoTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapWords"
                android:hint="Nombre del contacto" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de vencimiento -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fecha de Vencimiento (opcional)" android:textSize="13sp"
            android:textColor="@color/gris_texto" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaVenc" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:endIconMode="custom" app:endIconDrawable="@drawable/ic_calendario"
            app:endIconTint="@color/verde_primario">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaVencTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:focusable="false"
                android:inputType="none" android:hint="dd/mm/aaaa" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notas -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Notas" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotasTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotasTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textMultiLine"
                android:minLines="2" android:hint="Observaciones adicionales"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón adjuntar foto de factura -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdjuntarFoto"
            style="@style/Widget.Avicola.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📷 Adjuntar Foto de Factura / Recibo"
            android:textAllCaps="false" android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Botones guardar / cancelar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarTx"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="Cancelar" android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarTx"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Guardar" android:textAllCaps="false"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>