<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_reportes.xml
     Ubicación: res/layout/dialog_reportes.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Título -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Reporte de Inventario" android:textColor="@color/verde_oscuro"
                android:textSize="18sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarReportes" android:layout_width="32dp"
                android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                android:tint="@color/gris_texto" android:padding="4dp"/>
        </LinearLayout>

        <!-- Estadísticas en grid -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
            app:cardElevation="2dp" app:cardBackgroundColor="@color/verde_fondo"
            android:layout_marginBottom="16dp" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Resumen General" android:textColor="@color/verde_oscuro"
                    android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvTotalProductos" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="@color/verde_oscuro" android:textSize="28sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total productos" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvValorTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Q0.00"
                            android:textColor="@color/verde_oscuro" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Valor total" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvStockCritico" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#E53935" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Stock crítico" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvProximosVencer" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#F57C00" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por vencer" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Desglose por categoría -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Por categoría" android:textColor="@color/verde_oscuro"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvDesgloseCategorias" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/gris_texto"
            android:textSize="13sp" android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"/>

        <!-- Vencidos -->
        <TextView android:id="@+id/tvVencidos" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0"
            android:textColor="#B71C1C" android:textSize="13sp" android:visibility="gone"/>

        <!-- Card: Productos críticos -->
        <androidx.cardview.widget.CardView android:id="@+id/cardCriticos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="10dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFEBEE" android:layout_marginBottom="12dp"
            android:visibility="gone" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Stock Crítico" android:textColor="#C62828"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvListaCriticos" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#B71C1C"
                    android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Próximos a vencer -->
        <androidx.cardview.widget.CardView android:id="@+id/cardVencimientos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="10dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF3E0" android:layout_marginBottom="12dp"
            android:visibility="gone" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Próximos a Vencer" android:textColor="#E65100"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvListaVencimientos" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#BF360C"
                    android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
