<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_costo_real.xml — res/layout/ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el costo total real que tuvo esta producción para compararlo con la estimación."
        android:textColor="@color/gris_texto"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Avicola.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Costo real total (Q)"
        app:prefixText="Q ">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCostoReal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="El sistema calculará automáticamente la variación, pérdidas o ahorros respecto a la estimación."
        android:textColor="@color/gris_hint"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
