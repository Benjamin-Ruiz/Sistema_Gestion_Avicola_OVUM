<?xml version="1.0" encoding="utf-8"?>
<!-- item_vacunacion.xml — res/layout/ -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVacunacion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/fondo_card">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:id="@+id/tvVacNombre"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Vacuna"
                android:textColor="@color/verde_oscuro" android:textSize="14sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/tvVacEstado"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pendiente" android:textColor="@color/gris_hint" android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/tvVacLote"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Lote"
                android:textColor="@color/gris_texto" android:textSize="12sp"/>
            <TextView android:id="@+id/tvVacVia"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Vía" android:textColor="@color/gris_hint" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Próxima / Fecha" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                <TextView android:id="@+id/tvVacProxima"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/gris_texto" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvVacCosto"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/gris_hint" android:textSize="11sp"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnVacAplicar"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="Aplicar" android:textAllCaps="false" android:textSize="11sp"
                android:textColor="@color/blanco" android:background="@drawable/bg_tab_activo"
                android:paddingHorizontal="10dp" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnVacEliminar"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="Eliminar" android:textAllCaps="false" android:textSize="11sp"
                android:textColor="@color/rojo_salir" android:background="@android:color/transparent"
                android:paddingHorizontal="4dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
