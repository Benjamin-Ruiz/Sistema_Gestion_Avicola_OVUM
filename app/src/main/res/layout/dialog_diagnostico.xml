<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_diagnostico.xml — res/layout/ -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanco_semi">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <View android:layout_width="40dp" android:layout_height="4dp"
            android:background="@color/verde_claro" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔍 Diagnóstico asistido" android:textColor="@color/verde_oscuro"
            android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Selecciona los síntomas observados en el lote. El sistema sugerirá posibles enfermedades y tratamientos."
            android:textColor="@color/gris_texto" android:textSize="13sp"
            android:lineSpacingExtra="3dp" android:layout_marginBottom="14dp"/>

        <!-- Chips de síntomas -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSintomas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp"
            android:layout_marginBottom="14dp"/>

        <!-- Botón analizar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalizarSintomas"
            style="@style/Widget.Avicola.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analizar síntomas"
            android:layout_marginBottom="14dp"/>

        <!-- Resultado del diagnóstico -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#E8F5E9"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sugerencias de diagnóstico" android:textColor="@color/verde_oscuro"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvDiagnosticoResultado"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Selecciona síntomas y toca Analizar para ver sugerencias."
                    android:textColor="@color/gris_texto" android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btnCerrarDiagnostico"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:text="Cerrar" android:textAllCaps="false"
            android:textColor="@color/gris_hint" android:background="@android:color/transparent"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>