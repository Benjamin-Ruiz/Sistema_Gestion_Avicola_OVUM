<?xml version="1.0" encoding="utf-8"?>
<!-- activity_inventario.xml — Versión Pro
     Ubicación: res/layout/activity_inventario.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="4dp">

            <ImageView android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_logo_avicola" android:contentDescription="Logo"
                android:scaleType="fitCenter"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SISTEMA" android:textColor="@color/verde_oscuro"
                    android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AVÍCOLA" android:textColor="@color/verde_oscuro"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>

            <ImageButton android:id="@+id/btnReportes" android:layout_width="40dp"
                android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reportes" android:contentDescription="Reportes"
                android:tint="@color/verde_oscuro" android:padding="8dp"/>

            <ImageButton android:id="@+id/btnConfigToolbar" android:layout_width="40dp"
                android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_configuracion" android:contentDescription="Ajustes"
                android:tint="@color/verde_oscuro" android:padding="8dp" android:layout_marginEnd="4dp"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:overScrollMode="never">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp"
                android:paddingTop="16dp" android:paddingBottom="80dp">

                <!-- Título + contador -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/titulo_inventario"
                        android:textColor="@color/verde_oscuro" android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvContadorProductos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 productos" android:textColor="@color/gris_hint" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Buscador -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuscar" style="@style/Widget.Avicola.TextInputLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:startIconDrawable="@drawable/ic_buscar" app:startIconTint="@color/gris_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscar" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="@string/hint_buscar"
                        android:inputType="text" android:imeOptions="actionSearch" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Chips de alerta -->
                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStockCritico"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stock crítico" android:textSize="12sp"
                        android:textColor="@color/verde_oscuro"
                        app:chipBackgroundColor="@color/verde_suave"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipVencimiento"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Por vencer" android:textSize="12sp"
                        android:textColor="@color/verde_oscuro"
                        app:chipBackgroundColor="@color/verde_suave"/>
                </com.google.android.material.chip.ChipGroup>

                <!-- Chips de categoría (se agregan dinámicamente) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategorias"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="false"/>

                <!-- Tabla -->
                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                    app:cardElevation="3dp" app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Encabezado -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                            android:orientation="horizontal" android:background="@color/verde_suave"
                            android:gravity="center_vertical" android:paddingHorizontal="12dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="2" android:text="Producto"
                                android:textColor="@color/verde_oscuro" android:textSize="13sp" android:textStyle="bold"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1.2" android:text="Cantidad"
                                android:textColor="@color/verde_oscuro" android:textSize="13sp"
                                android:textStyle="bold" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1.2" android:text="Precio"
                                android:textColor="@color/verde_oscuro" android:textSize="13sp"
                                android:textStyle="bold" android:gravity="end"/>
                            <View android:layout_width="32dp" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerInventario"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" android:overScrollMode="never"/>

                        <!-- Vacío -->
                        <TextView android:id="@+id/tvVacio"
                            android:layout_width="match_parent" android:layout_height="60dp"
                            android:gravity="center" android:text="No hay productos en el inventario"
                            android:textColor="@color/gris_hint" android:textSize="13sp" android:visibility="gone"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Nav -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:background="@color/blanco" android:orientation="horizontal"
            android:gravity="center" android:elevation="8dp">

            <LinearLayout android:id="@+id/navInicio" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_inicio" android:contentDescription="Inicio"
                    android:tint="@color/verde_primario"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Inicio" android:textSize="10sp" android:textColor="@color/verde_primario"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navReportes" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_reportes" android:contentDescription="Reportes"
                    android:tint="@color/gris_hint"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Reportes" android:textSize="10sp" android:textColor="@color/gris_hint"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navConfig" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_configuracion" android:contentDescription="Configuración"
                    android:tint="@color/gris_hint"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Config." android:textSize="10sp" android:textColor="@color/gris_hint"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navSalir" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalirNav" style="@style/Widget.Avicola.Button.Salir"
                    android:layout_width="52dp" android:layout_height="34dp"
                    android:text="Salir" android:textAllCaps="false" android:textSize="11sp"
                    app:iconPadding="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAnadir"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center" android:layout_marginBottom="72dp"
        android:text="@string/btn_anadir_producto" android:textAllCaps="false"
        app:icon="@drawable/ic_anadir" app:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco" app:iconTint="@color/blanco"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
