<?xml version="1.0" encoding="utf-8"?>
<!-- activity_salud.xml — res/layout/ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        app:elevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_medico"
                app:tint="@color/blanco"
                android:contentDescription="Salud"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Control Sanitario"
                android:textColor="@color/blanco"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/progressSalud"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone"
                android:indeterminateTint="@color/blanco"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="72dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ALERTA EMERGENCIA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmergencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFEBEE"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvEmergencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#C62828"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RESUMEN SANITARIO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/verde_oscuro"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen Sanitario"
                        android:textColor="@color/blanco"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenEnRiesgo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/rojo_salir"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En riesgo"
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenUrgentes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/dorado"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Urgentes"
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenVacunas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/verde_claro"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vacunas pend."
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenCosto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Q0.00"
                                android:textColor="@color/blanco"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Costo san."
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÓN DIAGNÓSTICO ASISTIDO
                 CORRECCIÓN: wrap_content en lugar de 44dp fijo para que
                 el texto no quede cortado con el padding del estilo Primary -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnostico"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Diagnóstico asistido por síntomas"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="12dp"/>

            <!-- TABS
                 CORRECCIÓN: MaterialButton con backgroundTint="@null" para que
                 el drawable bg_tab_activo/inactivo se vea correctamente sin ser
                 sobreescrito por el tint del tema Material -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_spinner"
                android:padding="4dp"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabLotes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Lotes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/blanco"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_activo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabRegistros"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Registros"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabVacunas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Vacunas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabAlertas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Alertas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

            </LinearLayout>

            <!-- SECCIÓN LOTES -->
            <LinearLayout
                android:id="@+id/sectionLotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSinLotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay lotes activos. Crea lotes en Gestión de Aves."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN REGISTROS -->
            <LinearLayout
                android:id="@+id/sectionRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvSinRegistros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin registros médicos. Usa el botón + para agregar."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRegistros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN VACUNAS -->
            <LinearLayout
                android:id="@+id/sectionVacunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- CORRECCIÓN: wrap_content para que el texto no quede cortado -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNuevaVacuna"
                        style="@style/Widget.Avicola.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="+ Nueva vacunación"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/badgeVacunas"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/blanco"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_estado_pagado"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSinVacunas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin vacunaciones registradas."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerVacunas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN ALERTAS -->
            <LinearLayout
                android:id="@+id/sectionAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvSinAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin alertas activas. Todos los lotes están bajo control."
                    android:textColor="@color/verde_primario"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevoRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        app:srcCompat="@drawable/ic_anadir"
        app:backgroundTint="@color/verde_primario"
        app:tint="@color/blanco"
        android:contentDescription="Nuevo registro"/>

    <!-- BARRA INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/verde_oscuro"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_inicio"
                app:tint="@color/blanco"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/blanco"
                android:textSize="10sp"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:background="#44FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirNavSalud"
            style="@style/Widget.Avicola.Button.Salir"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Salir"
            app:icon="@drawable/ic_logout"
            app:iconSize="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>