<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRegistroMedico"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/fondo_card">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:id="@+id/tvRegTipo"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Tipo"
                android:textColor="@color/verde_oscuro" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvRegGravedad"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Leve" android:textColor="@color/gris_hint" android:textSize="11sp"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvRegFecha"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="01/01/25" android:textColor="@color/gris_hint" android:textSize="11sp"/>
        </LinearLayout>

        <TextView android:id="@+id/tvRegLote"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lote" android:textColor="@color/gris_texto" android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/tvRegDescripcion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Descripción" android:textColor="@color/gris_texto" android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvRegEstado"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Pendiente"
                android:textColor="@color/dorado" android:textSize="11sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvRegCosto"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/gris_hint" android:textSize="11sp"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnRegResolver"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="Resolver" android:textAllCaps="false" android:textSize="11sp"
                android:textColor="@color/blanco" android:background="@drawable/bg_badge_verde"
                android:paddingHorizontal="10dp" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnRegEliminar"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="Eliminar" android:textAllCaps="false" android:textSize="11sp"
                android:textColor="@color/rojo_salir" android:background="@android:color/transparent"
                android:paddingHorizontal="6dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
