<?xml version="1.0" encoding="utf-8"?>
<!-- activity_costos.xml — res/layout/ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_costos"
                app:tint="@color/blanco"
                android:contentDescription="Costos"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Estimación de Costos"
                android:textColor="@color/blanco"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressCostos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone"
                android:indeterminateTint="@color/blanco"/>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="160dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── MÉTRICAS RESUMEN ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/verde_oscuro"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen de Estimaciones"
                        android:textColor="@color/blanco"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaCantidad"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/blanco"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Total" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaRentables"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/verde_claro"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Rentables" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaRoi"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0%" android:textColor="@color/dorado"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ROI prom." android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaTotal"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Q0.00" android:textColor="@color/blanco"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Costo total" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FILTROS ── -->
            <!--
                CORRECCIÓN 1: Los botones usan android:backgroundTint="@null" para que
                Material Design no sobreescriba el drawable con el color del tema.
                Sin @null, MaterialButton aplica backgroundTint del tema (verde oscuro)
                sobre el drawable, ocultando el texto en los botones inactivos.

                También se cambia de <Button> a <com.google.android.material.button.MaterialButton>
                con backgroundTint="@null" para control total del fondo.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_spinner"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroTodas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Todas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/blanco"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_activo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroBorrador"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Borrador"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroActiva"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Activa"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroCompletada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Completada"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"/>

            </LinearLayout>

            <!-- Contador -->
            <TextView
                android:id="@+id/tvContadorEstimaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 estimaciones"
                android:textColor="@color/gris_hint"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <!-- Sin estimaciones -->
            <TextView
                android:id="@+id/tvSinEstimaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay estimaciones.\nToca + para crear tu primera estimación."
                android:textColor="@color/gris_hint"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingVertical="40dp"
                android:visibility="gone"/>

            <!-- RecyclerView estimaciones -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEstimaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
        CORRECCIÓN 2: El FAB estaba con layout_margin="16dp" y layout_marginBottom="80dp"
        pero la barra inferior mide 60dp, así que el FAB quedaba encima del botón Salir.

        Se sube el FAB a layout_marginBottom="80dp" (60dp barra + 20dp de separación)
        y se posiciona con layout_gravity="bottom|end" con margen horizontal de 16dp.

        El NestedScrollView también ajusta su paddingBottom a 160dp para que
        el último elemento nunca quede tapado por el FAB ni la barra.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevaEstimacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:text="Nueva estimación"
        app:icon="@drawable/ic_anadir"
        app:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco"
        app:iconTint="@color/blanco"/>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/verde_oscuro"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_inicio" app:tint="@color/blanco"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Inicio" android:textColor="@color/blanco" android:textSize="10sp"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="30dp" android:background="#44FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirNavCostos"
            style="@style/Widget.Avicola.Button.Salir"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Salir"
            app:icon="@drawable/ic_logout"
            app:iconSize="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>