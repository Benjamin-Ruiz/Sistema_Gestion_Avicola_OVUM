<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <ProgressBar
                android:id="@+id/progressSalud"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <!-- ALERTA EMERGENCIA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmergencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFEBEE"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvEmergencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#C62828"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RESUMEN SANITARIO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/verde_oscuro"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen Sanitario"
                        android:textColor="@color/blanco"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenEnRiesgo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/rojo_salir"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En riesgo"
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenUrgentes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/dorado"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Urgentes"
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenVacunas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/verde_claro"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vacunas pend."
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvResumenCosto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Q0.00"
                                android:textColor="@color/blanco"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Costo san."
                                android:textColor="#AAFFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÓN DIAGNÓSTICO ASISTIDO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnostico"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Diagnóstico asistido por síntomas"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="12dp"/>

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabLotes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Lotes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/blanco"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_activo"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabRegistros"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="Registros"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabVacunas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="Vacunas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabAlertas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Alertas"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_tab_inactivo"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:strokeWidth="0dp"/>

            </LinearLayout>

            <!-- SECCIÓN LOTES -->
            <LinearLayout
                android:id="@+id/sectionLotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSinLotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay lotes activos. Crea lotes en Gestión de Aves."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN REGISTROS -->
            <LinearLayout
                android:id="@+id/sectionRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvSinRegistros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin registros médicos. Usa el botón + para agregar."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRegistros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN VACUNAS -->
            <LinearLayout
                android:id="@+id/sectionVacunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNuevaVacuna"
                        style="@style/Widget.Avicola.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="+ Nueva vacunación"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/badgeVacunas"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/blanco"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_estado_pagado"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSinVacunas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin vacunaciones registradas."
                    android:textColor="@color/gris_hint"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerVacunas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- SECCIÓN ALERTAS -->
            <LinearLayout
                android:id="@+id/sectionAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvSinAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin alertas activas. Todos los lotes están bajo control."
                    android:textColor="@color/verde_primario"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevoRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:srcCompat="@drawable/ic_anadir"
        app:backgroundTint="@color/verde_primario"
        app:tint="@color/blanco"
        android:contentDescription="Nuevo registro"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>