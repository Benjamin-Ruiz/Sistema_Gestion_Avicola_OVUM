<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/blanco_semi">

    <!-- CORRECCIÓN: ic_logo_avicola no existe. Se usa ic_gallina que sí existe en el proyecto. -->
    <ImageView
        android:id="@+id/imgPlaceholder"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_gallina"
        android:alpha="0.25"
        android:contentDescription="Placeholder"
        app:tint="@color/verde_primario"/>

    <TextView
        android:id="@+id/tvPlaceholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Módulo en desarrollo"
        android:textColor="@color/verde_oscuro"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Estamos trabajando para traerte esta funcionalidad pronto."
        android:textAlignment="center"
        android:textColor="@color/gris_texto"
        android:textSize="14sp"/>

</LinearLayout>
