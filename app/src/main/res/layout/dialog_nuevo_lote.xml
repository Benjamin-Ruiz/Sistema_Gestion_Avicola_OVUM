<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/blanco">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Lote de Aves"
        android:textColor="@color/verde_oscuro"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etGalponId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID o Número de Galpón"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etLineaGenetica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Línea Genética (Cobb 500, etc.)"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Propósito"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/spinnerProposito"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etCantidadInicial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad Inicial de Aves"
        android:inputType="number"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnGuardarLote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Lote"
        android:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco"/>

</LinearLayout>
