<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        app:elevation="0dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/verde_primario"
            app:tabTextColor="@color/gris_hint"
            app:tabIndicatorColor="@color/verde_primario"
            app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendientes"/>
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finanzas Avícola"
                android:textColor="@color/verde_oscuro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvContadorTx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes actual"
                android:textColor="@color/gris_hint"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertaGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFEBEE"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvAlertaGastos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardCornerRadius="14dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="#E8F5E9">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↑ Ingresos" android:textColor="@color/verde_primario"
                            android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvIngresoTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro"
                            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    app:cardCornerRadius="14dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFEBEE">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↓ Gastos" android:textColor="@color/rojo_salir"
                            android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvGastoTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="#C62828"
                            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Beneficio" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvBeneficioNeto"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_primario"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ROI" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvRoi"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0.0%" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Costo/Ave" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvCostoPorAve"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/blanco"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="14dp" android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por Cobrar" android:textColor="@color/verde_primario"
                            android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPorCobrarResumen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro" android:textSize="16sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por Pagar" android:textColor="@color/rojo_salir"
                            android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPorPagarResumen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="#C62828" android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerReportes"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/reportes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPuntoEquilibrio"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/punto_equilibrio"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeudas"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/cuentas_pendientes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Transacciones Recientes" android:textColor="@color/verde_oscuro"
                android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvSinTransacciones"
                android:layout_width="match_parent" android:layout_height="80dp"
                android:gravity="center" android:text="No hay transacciones registradas"
                android:textColor="@color/gris_hint" android:textSize="13sp" android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTransacciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAgregarTransaccion"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center" android:layout_marginBottom="80dp"
        android:text="Nueva Transacción" android:textAllCaps="false"
        app:icon="@drawable/ic_anadir" app:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco" app:iconTint="@color/blanco"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>