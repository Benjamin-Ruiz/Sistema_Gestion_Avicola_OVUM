<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_registro_medico.xml — res/layout/ -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanco_semi">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <View android:layout_width="40dp" android:layout_height="4dp"
            android:background="@color/verde_claro" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nuevo Registro Médico" android:textColor="@color/verde_oscuro"
            android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

        <!-- Lote -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lote *" android:textColor="@color/gris_texto"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerRegistroLote"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_spinner" android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Tipo y Gravedad -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tipo" android:textColor="@color/gris_texto"
                    android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <Spinner android:id="@+id/spinnerRegistroTipo"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_spinner" android:paddingHorizontal="10dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gravedad" android:textColor="@color/gris_texto"
                    android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <Spinner android:id="@+id/spinnerRegistroGravedad"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_spinner" android:paddingHorizontal="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Descripción / síntomas observados" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistroDescripcion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="2" android:inputType="textMultiLine|textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Enfermedad sospechosa -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Enfermedad sospechosa (opcional)" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistroEnfermedad"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tratamiento -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Tratamiento aplicado" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistroTratamiento"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Medicamento del inventario -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Medicamento (del inventario)" android:textColor="@color/gris_texto"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerRegistroMedicamento"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_spinner" android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Dosis, Aves afectadas, Costo -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Dosis" android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroDosis"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapSentences"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Aves afectadas">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroAvesAfectadas"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Costo (Q)" android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroCosto"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Responsable">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroResponsable"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRegistro"
            style="@style/Widget.Avicola.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Guardar registro" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnCerrarRegistro"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:text="Cancelar" android:textAllCaps="false"
            android:textColor="@color/gris_hint" android:background="@android:color/transparent"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>