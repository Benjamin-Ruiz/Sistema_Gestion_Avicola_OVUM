<?xml version="1.0" encoding="utf-8"?>
<!-- item_ajuste.xml — Fila en el panel de Ajustes
     Ubicación: res/layout/item_ajuste.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvNombreAjuste" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/gris_texto"
            android:textSize="14sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvCantidadAjuste" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/gris_hint"
                android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" · " android:textColor="@color/gris_hint" android:textSize="12sp"/>
            <TextView android:id="@+id/tvCategoriaAjuste" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/verde_primario"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Botón editar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarAjuste"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="Editar" android:textAllCaps="false" android:textSize="12sp"
        android:layout_marginEnd="8dp"
        app:strokeColor="@color/verde_primario"
        android:textColor="@color/verde_primario"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <!-- Botón eliminar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEliminarAjuste"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="Eliminar" android:textAllCaps="false" android:textSize="12sp"
        app:backgroundTint="#E53935" android:textColor="@color/blanco"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
</LinearLayout>
