<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_vacunacion.xml — res/layout/ -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanco_semi">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <View android:layout_width="40dp" android:layout_height="4dp"
            android:background="@color/verde_claro" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Registrar Vacunación" android:textColor="@color/verde_oscuro"
            android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

        <!-- Lote -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lote *" android:textColor="@color/gris_texto"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerVacunaLote"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_spinner" android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Nombre vacuna y enfermedad -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nombre de la vacuna *" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVacunaNombre"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Enfermedad que previene" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVacunaEnfermedad"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vía de administración -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Vía de administración" android:textColor="@color/gris_texto"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerVacunaVia"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_spinner" android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Medicamento del inventario -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Vacuna del inventario (opcional)" android:textColor="@color/gris_texto"
            android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerVacunaMedicamento"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_spinner" android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Dosis, Aves, Costo, Responsable -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Dosis" android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVacunaDosis"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapSentences"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Aves vacunadas">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVacunaAves"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Costo (Q)" android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVacunaCosto"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Responsable">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVacunaResponsable"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Próxima vacunación -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Fecha próxima vacunación (opcional)" android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVacunaProxima"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:focusable="false" android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarVacuna"
            style="@style/Widget.Avicola.Button.Primary"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Guardar vacunación" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnCerrarVacuna"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:text="Cancelar" android:textAllCaps="false"
            android:textColor="@color/gris_hint" android:background="@android:color/transparent"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
