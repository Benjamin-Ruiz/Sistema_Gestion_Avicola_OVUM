<?xml version="1.0" encoding="utf-8"?>
<!-- item_sanitario.xml — res/layout/ -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#E8F5E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Nombre + Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nombre del ítem"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSanNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btnSanEliminar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_cerrar"
                android:background="@android:color/transparent"
                app:tint="@color/rojo_salir"
                android:contentDescription="Eliminar ítem"/>

        </LinearLayout>

        <!-- Tipo + Dosis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo"
                    android:textColor="@color/gris_texto"
                    android:textSize="11sp"
                    android:layout_marginBottom="2dp"/>
                <Spinner
                    android:id="@+id/spinnerSanTipo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingHorizontal="10dp"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Dosis/Unidades">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSanDosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Producto del inventario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Producto del inventario (medicinas)"
            android:textColor="@color/gris_texto"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerSanProducto"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="8dp"/>

        <!-- Costo y alerta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSanCosto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: Q0.00"
                android:textColor="@color/verde_oscuro"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSanStockAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Stock insuficiente"
                android:textColor="#E65100"
                android:textSize="10sp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
