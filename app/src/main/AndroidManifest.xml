<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso de internet para Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistemaAvicola">

        <!-- ───────────────────────────────
             Pantalla de inicio: LOGIN
             ─────────────────────────────── -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registro de usuario -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Dashboard / Menú principal -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- ───────────────────────────────
             MÓDULO ACTIVO: INVENTARIO
             ─────────────────────────────── -->
        <activity
            android:name=".ui.inventario.InventarioActivity"
            android:exported="false" />

        <!--
            MÓDULOS FUTUROS (descomentar cuando estén listos):

        <activity android:name=".ui.aves.GestionAvesActivity" android:exported="false" />
        <activity android:name=".ui.alimentacion.AlimentacionActivity" android:exported="false" />
        <activity android:name=".ui.temperatura.TemperaturaActivity" android:exported="false" />
        <activity android:name=".ui.medico.RegistroMedicoActivity" android:exported="false" />
        <activity android:name=".ui.finanzas.FinanzasActivity" android:exported="false" />
        <activity android:name=".ui.enfermedades.EnfermedadesActivity" android:exported="false" />
        <activity android:name=".ui.costos.CostosActivity" android:exported="false" />
        -->

    </application>

</manifest>
