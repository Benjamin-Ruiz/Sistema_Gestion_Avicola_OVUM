<file path="app/src/main/res/layout/item_lote.xml">
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvLoteId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/verde_oscuro"
                tools:text="Lote: #12345" />
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_verde"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/blanco"
                android:textSize="12sp"
                tools:text="ACTIVO" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInfoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            tools:text="Galpón 2 • Cobb 500 • Engorde" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Población" android:textSize="11sp" android:textColor="@color/gris_texto"/>
                <TextView android:id="@+id/tvPoblacion" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textStyle="bold" tools:text="450 aves"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Edad" android:textSize="11sp" android:textColor="@color/gris_texto"/>
                <TextView android:id="@+id/tvEdad" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textStyle="bold" tools:text="21 días"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Viabilidad" android:textSize="11sp" android:textColor="@color/gris_texto"/>
                <TextView android:id="@+id/tvViabilidad" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/verde_primario"
                    tools:text="98.5%"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarDiario"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Registrar Mortalidad / Peso"
            android:textAllCaps="false"
            app:icon="@drawable/ic_anadir" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</file>

<file path="app/src/main/res/layout/item_transaccion.xml">
