<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        app:elevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_costos" app:tint="@color/blanco"
                android:contentDescription="Formulario"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="Nueva Estimación" android:textColor="@color/blanco"
                android:textSize="18sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnCancelarForm"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Cancelar" android:textAllCaps="false" android:textColor="@color/blanco"
                android:background="@android:color/transparent" android:textSize="14sp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════ DATOS GENERALES ══════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Datos Generales" android:textColor="@color/verde_oscuro"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                    <!-- Nombre/Lote -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Avicola.TextInputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Nombre de la estimación" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreEstimacion"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textCapSentences"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Lote vinculado -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Lote activo (opcional)" android:textColor="@color/gris_texto"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLote"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="12dp" android:layout_marginBottom="10dp"/>

                    <!-- Tipo de ave -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tipo de ave" android:textColor="@color/gris_texto"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTipoAve"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="12dp" android:layout_marginBottom="10dp"/>

                    <!-- Cantidad y días -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Cant. aves" android:layout_marginEnd="6dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCantidadAves"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Días de crianza">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDiasCrianza"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Precio venta y costo ave -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Precio venta/ave (Q)"
                            android:layout_marginEnd="6dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrecioVenta"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Costo inicial/ave (Q)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCostoAveInicial"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Peso objetivo y mortalidad -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Peso objetivo (kg)"
                            android:layout_marginEnd="6dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPesoObjetivo"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Mortalidad (%)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMortalidad"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:text="5.0"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ ALIMENTACIÓN ══════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:id="@+id/headerAlimentacion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_alimento" app:tint="@color/verde_primario"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="8dp"
                            android:text="Alimentación por Fases" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_configuracion" app:tint="@color/gris_hint"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/seccionAlimentacion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerFases"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>

                        <Button android:id="@+id/btnAgregarFase"
                            android:layout_width="match_parent" android:layout_height="40dp"
                            android:text="+ Agregar fase" android:textAllCaps="false"
                            android:textColor="@color/verde_primario" android:textSize="13sp"
                            android:background="@drawable/bg_tab_inactivo" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ SANITARIO ══════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:id="@+id/headerSanitario"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_medico" app:tint="@color/verde_primario"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="8dp"
                            android:text="Costos Sanitarios" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_configuracion" app:tint="@color/gris_hint"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/seccionSanitario"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerSanitarios"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                        <Button android:id="@+id/btnAgregarSanitario"
                            android:layout_width="match_parent" android:layout_height="40dp"
                            android:text="+ Agregar ítem sanitario" android:textAllCaps="false"
                            android:textColor="@color/verde_primario" android:textSize="13sp"
                            android:background="@drawable/bg_tab_inactivo" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ OPERATIVOS ══════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:id="@+id/headerOperativo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_configuracion" app:tint="@color/verde_primario"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="8dp"
                            android:text="Costos Operativos" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_configuracion" app:tint="@color/gris_hint"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/seccionOperativo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerOperativos"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ ALERTA STOCK ══════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStockAlerta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                app:cardBackgroundColor="#FFEBEE" android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView android:id="@+id/tvStockAlerta"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="12dp" android:textColor="#C62828"
                    android:textSize="13sp" android:lineSpacingExtra="4dp"/>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ ALERTAS EN TIEMPO REAL ══════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertasForm"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF8E1" android:layout_marginBottom="12dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚠ Alertas" android:textColor="#F57F17"
                        android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvAlertasForm"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#795548" android:textSize="12sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════ RESULTADOS EN TIEMPO REAL ══════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:id="@+id/headerResultados"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_finanzas" app:tint="@color/verde_primario"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="8dp"
                            android:text="Resultados (en tiempo real)" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/seccionResultados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Alimentación"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResAlimentacion"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/verde_oscuro"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Sanitario"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResSanitario"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/verde_oscuro"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Operativo"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResOperativo"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/verde_oscuro"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Pérdida mortalidad"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResMortalidad"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/rojo_salir"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:background="@color/verde_claro" android:layout_marginVertical="8dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="COSTO TOTAL"
                                    android:textColor="@color/verde_oscuro" android:textSize="15sp"
                                    android:textStyle="bold"/>
                                <TextView android:id="@+id/tvResCostoTotal"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/verde_oscuro"
                                    android:textSize="15sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Costo por ave"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResCostoPorAve"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Costo diario"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResCostoDiario"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Costo semanal"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResCostoSemanal"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Costo mensual"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResCostoMensual"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:background="@color/verde_claro" android:layout_marginVertical="8dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Ingreso estimado"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResIngreso"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="GANANCIA NETA"
                                    android:textColor="@color/verde_oscuro" android:textSize="15sp"
                                    android:textStyle="bold"/>
                                <TextView android:id="@+id/tvResGanancia"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Q0.00" android:textSize="15sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="ROI"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResRoi"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0.0%" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Punto de equilibrio"
                                    android:textColor="@color/gris_texto" android:textSize="13sp"/>
                                <TextView android:id="@+id/tvResPuntoEquilibrio"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0 aves" android:textColor="@color/gris_texto"
                                    android:textSize="13sp"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notas -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Notas (opcional)" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotasEstimacion"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="2" android:inputType="textMultiLine|textCapSentences"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEstimacion"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Guardar Estimación"
                app:icon="@drawable/ic_anadir" app:iconSize="18dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
</file>

<file path="app/src/main/res/layout/activity_costos.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- activity_costos.xml — res/layout/ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_costos"
                app:tint="@color/blanco"
                android:contentDescription="Costos"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Estimación de Costos"
                android:textColor="@color/blanco"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressCostos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone"
                android:indeterminateTint="@color/blanco"/>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── MÉTRICAS RESUMEN ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/verde_oscuro"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen de Estimaciones"
                        android:textColor="@color/blanco"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaCantidad"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/blanco"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Total" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaRentables"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/verde_claro"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Rentables" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaRoi"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0%" android:textColor="@color/dorado"
                                android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ROI prom." android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMetricaTotal"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Q0.00" android:textColor="@color/blanco"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Costo total" android:textColor="#AAFFFFFF" android:textSize="11sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FILTROS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_spinner"
                android:padding="3dp">

                <Button android:id="@+id/btnFiltroTodas"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Todas" android:textAllCaps="false" android:textSize="11sp"
                    android:textColor="@color/blanco" android:background="@drawable/bg_tab_activo"
                    android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center"/>

                <Button android:id="@+id/btnFiltroBorrador"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Borrador" android:textAllCaps="false" android:textSize="11sp"
                    android:textColor="@color/verde_primario" android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center"/>

                <Button android:id="@+id/btnFiltroActiva"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Activa" android:textAllCaps="false" android:textSize="11sp"
                    android:textColor="@color/verde_primario" android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center"/>

                <Button android:id="@+id/btnFiltroCompletada"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:text="Completada" android:textAllCaps="false" android:textSize="10sp"
                    android:textColor="@color/verde_primario" android:background="@drawable/bg_tab_inactivo"
                    android:paddingTop="0dp" android:paddingBottom="0dp" android:gravity="center"/>

            </LinearLayout>

            <!-- Contador -->
            <TextView
                android:id="@+id/tvContadorEstimaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 estimaciones"
                android:textColor="@color/gris_hint"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <!-- Sin estimaciones -->
            <TextView
                android:id="@+id/tvSinEstimaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay estimaciones.\nToca + para crear tu primera estimación."
                android:textColor="@color/gris_hint"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingVertical="40dp"
                android:visibility="gone"/>

            <!-- RecyclerView estimaciones -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEstimaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevaEstimacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="80dp"
        android:text="Nueva estimación"
        app:icon="@drawable/ic_anadir"
        app:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco"
        app:iconTint="@color/blanco"/>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/verde_oscuro"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_inicio" app:tint="@color/blanco"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Inicio" android:textColor="@color/blanco" android:textSize="10sp"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="30dp" android:background="#44FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirNavCostos"
            style="@style/Widget.Avicola.Button.Salir"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Salir"
            app:icon="@drawable/ic_logout"
            app:iconSize="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
</file>

<file path="app/src/main/res/layout/dialog_costo_real.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_costo_real.xml — res/layout/ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el costo total real que tuvo esta producción para compararlo con la estimación."
        android:textColor="@color/gris_texto"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Avicola.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Costo real total (Q)"
        app:prefixText="Q ">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCostoReal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="El sistema calculará automáticamente la variación, pérdidas o ahorros respecto a la estimación."
        android:textColor="@color/gris_hint"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
</file>

<file path="app/src/main/res/layout/dialog_detalle_estimacion.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_detalle_estimacion.xml — res/layout/ -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanco_semi">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/verde_claro"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetLote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lote"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvDetTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pollo de Engorde"
                        android:textColor="@color/gris_hint"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textColor="@color/gris_hint"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tvDetFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01/01/2025"
                        android:textColor="@color/gris_hint"
                        android:textSize="12sp"/>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvDetAves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 aves"
                    android:textColor="@color/verde_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDetDias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 días"
                    android:textColor="@color/gris_hint"
                    android:textSize="12sp"/>

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/verde_claro"
            android:layout_marginVertical="14dp"/>

        <!-- ── DESGLOSE DE COSTOS ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESGLOSE DE COSTOS"
            android:textColor="@color/gris_hint"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>

        <!-- Fila Alimentación -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Alimentación"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetCostoAlim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/verde_oscuro"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Fila Sanitario -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Sanitario"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetCostoSan"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/verde_oscuro"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Fila Operativo -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Operativo"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetCostoOp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/verde_oscuro"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Fila Mortalidad -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Pérdida por mortalidad"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetMortalidad"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00 (5.0%)" android:textColor="@color/rojo_salir"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/verde_claro" android:layout_marginVertical="10dp"/>

        <!-- Costo total -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="COSTO TOTAL"
                android:textColor="@color/verde_oscuro" android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tvDetCostoTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/verde_oscuro"
                android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Costo por ave"
                android:textColor="@color/gris_hint" android:textSize="13sp"/>
            <TextView android:id="@+id/tvDetCostoPorAve"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/gris_hint" android:textSize="13sp"/>
        </LinearLayout>

        <!-- ── RENTABILIDAD ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RENTABILIDAD"
            android:textColor="@color/gris_hint"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Ingreso estimado"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetIngreso"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textColor="@color/gris_texto" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="GANANCIA NETA"
                android:textColor="@color/verde_oscuro" android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tvDetGanancia"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Q0.00" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="ROI"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetRoi"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0.0%" android:textColor="@color/verde_primario"
                android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Punto de equilibrio"
                android:textColor="@color/gris_texto" android:textSize="14sp"/>
            <TextView android:id="@+id/tvDetPE"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 aves" android:textColor="@color/gris_texto" android:textSize="14sp"/>
        </LinearLayout>

        <!-- ── COMPARACIÓN REAL vs ESTIMADO ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardComparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#E3F2FD"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COSTO ESTIMADO vs REAL"
                    android:textColor="#1565C0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Costo real registrado"
                        android:textColor="@color/gris_texto" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetCostoReal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Q0.00" android:textColor="#1565C0"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Diferencia (real − estimado)"
                        android:textColor="@color/gris_texto" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetDiferencia"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Q0.00" android:textColor="@color/gris_texto"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Variación"
                        android:textColor="@color/gris_texto" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetVariacion"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0.0%" android:textColor="@color/gris_texto"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Precisión de la estimación"
                        android:textColor="@color/gris_texto" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvDetEficiencia"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1565C0"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── ALERTAS ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF8E1"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ Alertas detectadas"
                    android:textColor="#F57F17"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvDetAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#795548"
                    android:textSize="12sp"
                    android:lineSpacingExtra="5dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── BOTONES DE ACCIÓN ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetEditar"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Editar estimación"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetCostoReal"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Registrar costo real"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetFinanzas"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Enviar a Finanzas"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDetCerrar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Cerrar"
                android:textAllCaps="false"
                android:textColor="@color/gris_hint"
                android:background="@android:color/transparent"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</file>

