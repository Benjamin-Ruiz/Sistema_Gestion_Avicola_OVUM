<file path="app/src/main/res/layout/activity_login.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_login.xml
    Pantalla de autenticación del Sistema Avícola
    Coloca este archivo en: res/layout/activity_login.xml
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo (granja con gallinas) -->
    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/fondo_granja" />

    <!-- Overlay semitransparente para legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AAFFFFFF" />

    <!-- Contenido principal con scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="32dp"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <!-- Logo de la gallina con sol dorado -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:src="@drawable/ic_logo_avicola"
                android:contentDescription="Logo Sistema Avícola"
                android:scaleType="fitCenter" />

            <!-- Nombre del sistema -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textColor="@color/verde_oscuro"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-condensed" />

            <!-- Espacio -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Etiqueta Usuario -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_usuario"
                android:textColor="@color/gris_texto"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Campo de texto Usuario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsuario"
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_persona"
                app:startIconTint="@color/verde_primario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_usuario"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:textColor="@color/gris_texto"
                    android:textSize="15sp"
                    android:paddingVertical="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Espacio -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Etiqueta Contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_contrasena"
                android:textColor="@color/gris_texto"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Campo de texto Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContrasena"
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_candado"
                app:startIconTint="@color/verde_primario"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/verde_primario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_contrasena"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:textColor="@color/gris_texto"
                    android:textSize="15sp"
                    android:paddingVertical="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Espacio -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- Botón Iniciar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_iniciar_sesion"
                android:textAllCaps="false" />

            <!-- ProgressBar (oculto por defecto) -->
            <ProgressBar
                android:id="@+id/progressLogin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/verde_primario" />

            <!-- Espacio flexible -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="60dp" />

            <!-- Botón Registrarse (outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarse"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_registrarse"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
</file>

