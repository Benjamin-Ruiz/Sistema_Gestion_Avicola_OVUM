<file path="app/src/main/res/layout/dialog_deuda.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_deuda.xml
     Ubicación: res/layout/dialog_deuda.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Cuentas Pendientes"
                android:textColor="@color/verde_oscuro" android:textSize="18sp"
                android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarDeudas" android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                android:tint="@color/gris_texto" android:padding="4dp"/>
        </LinearLayout>

        <!-- Por Cobrar -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
            app:cardElevation="2dp" app:cardBackgroundColor="#E8F5E9"
            android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Por Cobrar (Clientes)"
                        android:textColor="@color/verde_oscuro" android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTotalCobrar"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/verde_primario" android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:id="@+id/tvListaCobrar"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/gris_texto" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Por Pagar -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
            app:cardElevation="2dp" app:cardBackgroundColor="#FFEBEE"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Por Pagar (Proveedores)"
                        android:textColor="#C62828" android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTotalPagar"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/rojo_salir" android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:id="@+id/tvListaPagar"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/gris_texto" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
</file>

<file path="app/src/main/res/layout/dialog_filtros.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_spinner">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtros Avanzado"
            android:textColor="@color/verde_oscuro"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnCerrarFiltros"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cerrar"
            app:tint="@color/gris_texto" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rango de Precio"
        android:textColor="@color/gris_texto"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Min">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecioMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <View android:layout_width="16dp" android:layout_height="1dp"/>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Max">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecioMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ordenar por"
        android:textColor="@color/gris_texto"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgOrden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
        <RadioButton
            android:id="@+id/rbNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre (A-Z)"
            android:checked="true" />
        <RadioButton
            android:id="@+id/rbPrecioMenor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio (Menor a Mayor)" />
        <RadioButton
            android:id="@+id/rbPrecioMayor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio (Mayor a Menor)" />
        <RadioButton
            android:id="@+id/rbCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad Stock" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiarFiltros"
            style="@style/Widget.Avicola.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Limpiar" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAplicarFiltros"
            style="@style/Widget.Avicola.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aplicar" />
    </LinearLayout>

</LinearLayout>
</file>

