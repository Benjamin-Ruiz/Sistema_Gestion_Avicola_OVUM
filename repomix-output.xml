                val venc = if (t.fechaVencimientoMs > 0) " (Vence: ${sdf.format(Date(t.fechaVencimientoMs))})" else ""
                sbCobrar.appendLine("â€¢ ${t.contacto.ifEmpty { "Cliente" }}: Q${String.format("%.2f", t.montoPendiente())} â€” ${t.estado}$venc")
            }
