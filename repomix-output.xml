                                    "No se pudo enviar el correo de verificaciÃ³n",
                                    Toast.LENGTH_SHORT).show()
                            }
                            auth.signOut()
                            finish()
                        }
                } else {
                    Toast.makeText(this,
                        "Error: ${task.exception?.message}",
                        Toast.LENGTH_LONG).show()
                }
            }
    }

