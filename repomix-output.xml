 * UbicaciÃ³n: app/src/main/java/com/universidad/avicola/data/model/
 *
 * Nuevos campos aÃ±adidos:
 *  - minStock       â†’ stock mÃ­nimo para alertas de stock crÃ­tico
 *  - categoria      â†’ categorÃ­a del producto (enum Categoria)
 *  - unitType       â†’ tipo de unidad (Sacos, ml, Unidades, etc.)
 *  - numerolote     â†’ nÃºmero de lote del producto
 *  - fechaVencimientoMs â†’ fecha de vencimiento en millisegundos
 */
data class ProductoInventario(
    val id: String = "",
    val nombre: String = "",
    val cantidad: Double = 0.0,
    val precioUnitario: Double = 0.0,

    // â”€â”€ Stock crÃ­tico â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val minStock: Double = 0.0,

    // â”€â”€ CategorÃ­a y unidades â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val categoria: String = Categoria.ALIMENTOS.name,
    val unitType: String = "Unidades",

    // â”€â”€ Lote y caducidad â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val numeroLote: String = "",
    val fechaVencimientoMs: Long = 0L,

    // â”€â”€ AuditorÃ­a â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val fechaCreacion: Long = System.currentTimeMillis(),
    val fechaActualizacion: Long = System.currentTimeMillis(),
) {
    constructor() : this("", "", 0.0, 0.0, 0.0, Categoria.ALIMENTOS.name, "Unidades", "", 0L, 0L, 0L)

    /** Retorna true si el stock actual estÃ¡ en nivel crÃ­tico */
    fun isStockCritico(): Boolean = cantidad <= minStock && minStock > 0

    /** Retorna true si vence en los prÃ³ximos 7 dÃ­as */
    fun isProximoAVencer(): Boolean {
        if (fechaVencimientoMs == 0L) return false
        val diasRestantes = (fechaVencimientoMs - System.currentTimeMillis()) / (1000 * 60 * 60 * 24)
        return diasRestantes in 0..7
    }

    /** Retorna true si ya venciÃ³ */
    fun isVencido(): Boolean {
        if (fechaVencimientoMs == 0L) return false
        return fechaVencimientoMs < System.currentTimeMillis()
    }

    /** Texto de cantidad con unidad: "10 Sacos", "500 ml" */
    fun cantidadConUnidad(): String {
        val cantStr = if (cantidad % 1.0 == 0.0) cantidad.toInt().toString()
                      else String.format("%.1f", cantidad)
        return "$cantStr $unitType"
    }
