                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/verde_primario" android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:id="@+id/tvListaCobrar"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/gris_texto" android:textSize="12sp"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Por Pagar -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
