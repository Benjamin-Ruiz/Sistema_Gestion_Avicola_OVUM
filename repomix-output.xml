        fecha = fecha,
        mortalidad = mortalidad,
        descarte = descarte,
        pesoPromedio = pesoPromedio,
        observaciones = observaciones
    )

    companion object {
        fun fromDomain(r: RegistroDiarioAves) = RegistroDiarioEntity(
            id = r.id,
            loteId = r.loteId,
            fecha = r.fecha,
            mortalidad = r.mortalidad,
            descarte = r.descarte,
            pesoPromedio = r.pesoPromedio,
