                    b.tvIndicador.visibility = android.view.View.GONE
                }
            }

            // Click â†’ editar producto
            b.rowContenido.setOnClickListener { onItemClick(p) }

            b.rowContenido.setOnLongClickListener {
                onLongClick(p)
                true
            }

            // Click en historial
