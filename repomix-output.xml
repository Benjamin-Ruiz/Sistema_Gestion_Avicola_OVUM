 */
data class ProductoInventario(
    val id: String = "",
    val nombre: String = "",
    val cantidad: Double = 0.0,
    val precioUnitario: Double = 0.0,

    // â”€â”€ Stock crÃ­tico â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val minStock: Double = 0.0,

    // â”€â”€ CategorÃ­a y unidades â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val categoria: String = Categoria.ALIMENTOS.name,
    val unitType: String = "Unidades",

    // â”€â”€ Lote y caducidad â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val numeroLote: String = "",
    val fechaVencimientoMs: Long = 0L,

    // â”€â”€ AuditorÃ­a â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    val fechaCreacion: Long = System.currentTimeMillis(),
    val fechaActualizacion: Long = System.currentTimeMillis(),
