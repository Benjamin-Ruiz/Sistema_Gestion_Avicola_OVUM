<?xml version="1.0" encoding="utf-8"?>
<!-- activity_costos_form.xml â€” res/layout/ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        app:elevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_costos" app:tint="@color/blanco"
                android:contentDescription="Formulario"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="Nueva EstimaciÃ³n" android:textColor="@color/blanco"
                android:textSize="18sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnCancelarForm"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Cancelar" android:textAllCaps="false" android:textColor="@color/blanco"
                android:background="@android:color/transparent" android:textSize="14sp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â• DATOS GENERALES â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/fondo_card"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Datos Generales" android:textColor="@color/verde_oscuro"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                    <!-- Nombre/Lote -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Avicola.TextInputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Nombre de la estimaciÃ³n" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreEstimacion"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textCapSentences"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Lote vinculado -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Lote activo (opcional)" android:textColor="@color/gris_texto"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLote"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="12dp" android:layout_marginBottom="10dp"/>

                    <!-- Tipo de ave -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tipo de ave" android:textColor="@color/gris_texto"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTipoAve"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="12dp" android:layout_marginBottom="10dp"/>

                    <!-- Cantidad y dÃ­as -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Avicola.TextInputLayout"
