<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#F1F8E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Nombre de fase + Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nombre de fase"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFaseNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btnFaseEliminar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_cerrar"
                android:background="@android:color/transparent"
                app:tint="@color/rojo_salir"
                android:contentDescription="Eliminar fase"/>

        </LinearLayout>

        <!-- Días y consumo diario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Días"
                android:layout_marginEnd="6dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFaseDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Consumo (g/ave/día)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFaseConsumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Producto del inventario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alimento del inventario"
            android:textColor="@color/gris_texto"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerFaseProducto"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="8dp"/>

        <!-- Costo calculado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFaseCosto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vincula un producto para calcular costo"
                android:textColor="@color/gris_hint"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tvFaseStockAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Stock insuficiente"
                android:textColor="#E65100"
                android:textSize="10sp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
</file>

