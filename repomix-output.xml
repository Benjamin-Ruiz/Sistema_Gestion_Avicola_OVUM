                android:textSize="17sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnCerrarDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar"
                android:contentDescription="Cerrar"
                android:tint="@color/gris_texto"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Categoría (AHORA PRIMERO) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Categoría" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Nombre -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nombre del Producto *" android:textSize="13sp"
            android:textColor="@color/gris_texto" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombreProducto"
            style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreProducto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapWords" android:imeOptions="actionNext" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila: Cantidad + Min Stock -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cantidad *" android:textSize="13sp" android:textColor="@color/gris_texto"
                    android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCantidad" style="@style/Widget.Avicola.TextInputLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCantidad" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Stock mínimo" android:textSize="13sp" android:textColor="@color/gris_texto"
                    android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMinStock" style="@style/Widget.Avicola.TextInputLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMinStock" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:hint="0" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Precio -->
        <TextView android:id="@+id/tvPrecioLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Precio Unitario" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPrecio" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:prefixText="Q ">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecio" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Unidad -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Unidad de medida" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerUnidad"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Número de lote -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Número de Lote" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNumeroLote" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNumeroLote" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:hint="Ej: LOT-2024-001" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de vencimiento (SE PUEDE OCULTAR) -->
        <TextView android:id="@+id/tvFechaLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fecha de Vencimiento" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFecha" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:endIconMode="custom" app:endIconDrawable="@drawable/ic_calendario"
            app:endIconTint="@color/verde_primario">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFecha" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:focusable="false"
                android:inputType="none" android:hint="dd/mm/aaaa" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Razón del cambio (solo visible al editar) -->
        <TextView android:id="@+id/tvRazonLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Razón del cambio" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp" android:visibility="gone"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRazon" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRazonCambio" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:hint="Ej: Compra, Ajuste, Merma..." android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarDialog"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="Cancelar" android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarProducto"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Guardar" android:textAllCaps="false"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</file>

