    fun aplicarFiltros(lista: List<Transaccion>) {
        var resultado = lista

        filtroTipo?.let { tipo ->
            resultado = resultado.filter { it.tipo == tipo }
        }
        filtroCategoria?.let { cat ->
            resultado = resultado.filter { it.categoria == cat }
        }
        filtroEstado?.let { estado ->
