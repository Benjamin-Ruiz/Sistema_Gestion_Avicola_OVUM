--- FILE: C:\AVICOLA1.1\app\build\intermediates\packaged_res\debug\packageDebugResources\layout\activity_dashboard.xml ---
<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_dashboard.xml
    Pantalla de bienvenida con grid de mÃ³dulos del Sistema AvÃ­cola
    Coloca este archivo en: res/layout/activity_dashboard.xml
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo (granja) -->
    <ImageView
        android:id="@+id/imgFondoDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/fondo_granja" />

    <!-- Overlay claro para legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF" />

    <!-- ScrollView con todo el contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogoDash"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_logo_avicola"
                android:contentDescription="Logo"
                android:scaleType="fitCenter" />

            <!-- Nombre sistema -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_name"
                android:textColor="@color/verde_oscuro"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-condensed" />

            <!-- Mensaje bienvenida -->
            <TextView
                android:id="@+id/tvBienvenido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/bienvenido"
                android:textColor="@color/verde_oscuro"
                android:textSize="26sp"
                android:textStyle="bold" />



            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <!--  GRID DE MÃ“DULOS (2 columnas)          -->
            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->

            <!-- Fila 1: Inventario | GestiÃ³n de Aves -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Inventario (ACTIVO) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardInventario"
                    style="@style/Widget.Avicola.ModuleCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_inventario"
                            android:contentDescription="Inventario"
                            android:background="@drawable/bg_icono_modulo"
                            android:padding="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                style="@style/TextAppearance.Avicola.ModuleTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/modulo_inventario" />

                            <TextView
                                style="@style/TextAppearance.Avicola.ModuleSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reservas y productos" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- GestiÃ³n de Aves (prÃ³ximamente) -->
