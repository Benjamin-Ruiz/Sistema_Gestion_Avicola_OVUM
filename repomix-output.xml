                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/verde_primario"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView android:id="@+id/tvCategoriaTx"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/gris_hint"
                    android:textSize="11sp"/>

                <TextView android:id="@+id/tvEstadoTx"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textStyle="bold"
                    android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                    android:background="@drawable/bg_estado_pagado"
                    android:textColor="@color/blanco"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="2dp">

                <TextView android:id="@+id/tvFechaTx"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/gris_hint"
                    android:textSize="10sp"/>

                <TextView android:id="@+id/tvContactoTx"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/gris_hint" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
</file>

