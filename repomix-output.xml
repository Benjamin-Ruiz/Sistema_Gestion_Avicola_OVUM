<file path="app/src/main/res/layout/dialog_reporte_financiero.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_reporte_financiero.xml
     Ubicación: res/layout/dialog_reporte_financiero.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Reporte Financiero"
                android:textColor="@color/verde_oscuro" android:textSize="18sp"
                android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarReporte" android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                app:tint="@color/gris_texto" android:padding="4dp"/>   <!-- CORREGIDO -->
        </LinearLayout>

        <!-- Resumen de totales -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
            app:cardElevation="2dp" app:cardBackgroundColor="@color/verde_fondo"
            android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ingresos" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRptIngresos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_primario"
                            android:textSize="20sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gastos" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRptGastos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/rojo_salir"
                            android:textSize="20sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Beneficio Neto" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRptBeneficio"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ROI" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRptRoi"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0.0%" android:textColor="@color/verde_oscuro"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Desglose por categoría -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gastos por Categoría" android:textColor="@color/verde_oscuro"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvRptDesgloseCat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/gris_texto" android:textSize="13sp"
            android:lineSpacingMultiplier="1.5" android:layout_marginBottom="16dp"/>

        <!-- Filtros de período -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Filtrar por Período" android:textColor="@color/verde_oscuro"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroSemana"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:layout_marginEnd="4dp"
                android:text="Semana" android:textAllCaps="false" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroMes"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp"
                android:text="Mes" android:textAllCaps="false" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroAnio"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:layout_marginStart="4dp"
                android:text="Año" android:textAllCaps="false" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Exportar -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Exportar Reporte" android:textColor="@color/verde_oscuro"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarPdf"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="📄 Exportar PDF" android:textAllCaps="false" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarExcel"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="📊 Exportar Excel" android:textAllCaps="false" android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</file>

<file path="app/src/main/res/layout/dialog_reportes.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_reportes.xml
     Ubicación: res/layout/dialog_reportes.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Título -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Reporte de Inventario" android:textColor="@color/verde_oscuro"
                android:textSize="18sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarReportes" android:layout_width="32dp"
                android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                android:tint="@color/gris_texto" android:padding="4dp"/>
        </LinearLayout>

        <!-- Estadísticas en grid -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="12dp"
            app:cardElevation="2dp" app:cardBackgroundColor="@color/verde_fondo"
            android:layout_marginBottom="16dp" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Resumen General" android:textColor="@color/verde_oscuro"
                    android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvTotalProductos" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="@color/verde_oscuro" android:textSize="28sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total productos" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvValorTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Q0.00"
                            android:textColor="@color/verde_oscuro" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Valor total" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvStockCritico" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#E53935" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Stock crítico" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvProximosVencer" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="#F57C00" android:textSize="24sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por vencer" android:textColor="@color/gris_texto" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Desglose por categoría -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Por categoría" android:textColor="@color/verde_oscuro"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvDesgloseCategorias" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/gris_texto"
            android:textSize="13sp" android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"/>

        <!-- Vencidos -->
        <TextView android:id="@+id/tvVencidos" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0"
            android:textColor="#B71C1C" android:textSize="13sp" android:visibility="gone"/>

        <!-- Card: Productos críticos -->
        <androidx.cardview.widget.CardView android:id="@+id/cardCriticos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="10dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFEBEE" android:layout_marginBottom="12dp"
            android:visibility="gone" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Stock Crítico" android:textColor="#C62828"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvListaCriticos" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#B71C1C"
                    android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Próximos a vencer -->
        <androidx.cardview.widget.CardView android:id="@+id/cardVencimientos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="10dp" app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF3E0" android:layout_marginBottom="12dp"
            android:visibility="gone" xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Próximos a Vencer" android:textColor="#E65100"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvListaVencimientos" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#BF360C"
                    android:textSize="12sp" android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
</file>

<file path="app/src/main/res/layout/dialog_transaccion.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_transaccion.xml
     Ubicación: res/layout/dialog_transaccion.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/blanco">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Nueva Transacción"
                android:textColor="@color/verde_oscuro" android:textSize="17sp" android:textStyle="bold"/>
            <ImageButton android:id="@+id/btnCerrarTx" android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar" android:contentDescription="Cerrar"
                app:tint="@color/gris_texto" android:padding="4dp"/>   <!-- CORREGIDO -->
        </LinearLayout>

        <!-- Selector Ingreso / Gasto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_spinner"
            android:padding="3dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTipoIngreso"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="↑ Ingreso"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/verde_oscuro"
                android:gravity="center"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <Button
                android:id="@+id/btnTipoGasto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="↓ Gasto"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/verde_oscuro"
                android:gravity="center"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

        </LinearLayout>

        <!-- Categoría -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Categoría" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Descripción -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Descripción" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcionTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences"
                android:hint="Ej: Venta de 200 pollos" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Monto -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Monto *" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMontoTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:prefixText="Q ">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMontoTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estado de pago -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Estado de Pago" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerEstado"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="14dp" android:paddingHorizontal="10dp"/>

        <!-- Monto pagado (solo si es PARCIAL) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMontoPagado" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:prefixText="Q "
            android:hint="Monto ya pagado" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMontoPagado" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contacto (cliente o proveedor) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cliente / Proveedor" android:textSize="13sp"
            android:textColor="@color/gris_texto" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactoTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactoTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapWords"
                android:hint="Nombre del contacto" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de vencimiento -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fecha de Vencimiento (opcional)" android:textSize="13sp"
            android:textColor="@color/gris_texto" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaVenc" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:endIconMode="custom" app:endIconDrawable="@drawable/ic_calendario"
            app:endIconTint="@color/verde_primario">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaVencTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:focusable="false"
                android:inputType="none" android:hint="dd/mm/aaaa" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notas -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Notas" android:textSize="13sp" android:textColor="@color/gris_texto"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotasTx" style="@style/Widget.Avicola.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotasTx" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textMultiLine"
                android:minLines="2" android:hint="Observaciones adicionales"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón adjuntar foto de factura -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdjuntarFoto"
            style="@style/Widget.Avicola.Button.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📷 Adjuntar Foto de Factura / Recibo"
            android:textAllCaps="false" android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Botones guardar / cancelar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarTx"
                style="@style/Widget.Avicola.Button.Secondary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="Cancelar" android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarTx"
                style="@style/Widget.Avicola.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Guardar" android:textAllCaps="false"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</file>

<file path="app/src/main/res/layout/fragment_finanzas.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        app:elevation="0dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/verde_primario"
            app:tabTextColor="@color/gris_hint"
            app:tabIndicatorColor="@color/verde_primario"
            app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendientes"/>
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finanzas Avícola"
                android:textColor="@color/verde_oscuro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvContadorTx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes actual"
                android:textColor="@color/gris_hint"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertaGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFEBEE"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvAlertaGastos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardCornerRadius="14dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="#E8F5E9">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↑ Ingresos" android:textColor="@color/verde_primario"
                            android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvIngresoTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro"
                            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    app:cardCornerRadius="14dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFEBEE">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↓ Gastos" android:textColor="@color/rojo_salir"
                            android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvGastoTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="#C62828"
                            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Beneficio" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvBeneficioNeto"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_primario"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ROI" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvRoi"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0.0%" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    app:cardCornerRadius="12dp" app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/blanco">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Costo/Ave" android:textColor="@color/gris_hint" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvCostoPorAve"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/blanco"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="14dp" android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por Cobrar" android:textColor="@color/verde_primario"
                            android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPorCobrarResumen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="@color/verde_oscuro" android:textSize="16sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por Pagar" android:textColor="@color/rojo_salir"
                            android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPorPagarResumen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Q0.00" android:textColor="#C62828" android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerReportes"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/reportes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPuntoEquilibrio"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/punto_equilibrio"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeudas"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/cuentas_pendientes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/verde_primario"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Transacciones Recientes" android:textColor="@color/verde_oscuro"
                android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvSinTransacciones"
                android:layout_width="match_parent" android:layout_height="80dp"
                android:gravity="center" android:text="No hay transacciones registradas"
                android:textColor="@color/gris_hint" android:textSize="13sp" android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTransacciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAgregarTransaccion"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center" android:layout_marginBottom="80dp"
        android:text="Nueva Transacción" android:textAllCaps="false"
        app:icon="@drawable/ic_anadir" app:backgroundTint="@color/verde_primario"
        android:textColor="@color/blanco" app:iconTint="@color/blanco"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
</file>

<file path="app/src/main/res/layout/fragment_inventario.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBuscar"
                style="@style/Widget.Avicola.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_buscar">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar producto..."
                    android:inputType="text"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFiltros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStockCritico"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock Bajo"
                            app:chipBackgroundColor="@color/verde_suave" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVencimiento"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Por Vencer"
                            app:chipBackgroundColor="@color/verde_suave" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnAnadirFiltro"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Filtros"
                        android:textColor="@color/verde_primario"
                        app:chipBackgroundColor="@color/blanco"
                        app:chipIcon="@drawable/ic_anadir"
                        app:chipIconSize="18dp"
                        app:chipIconTint="@color/verde_primario"
                        app:chipStrokeColor="@color/verde_primario"
                        app:chipStrokeWidth="1dp" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@color/verde_suave"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2" android:text="Producto"
                android:textColor="@color/verde_oscuro" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Cant."
                android:textColor="@color/verde_oscuro" android:textSize="12sp"
                android:textStyle="bold" android:gravity="center"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Precio"
                android:textColor="@color/verde_oscuro" android:textSize="12sp"
                android:textStyle="bold" android:gravity="end"/>
            <View android:layout_width="40dp" android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInventario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <TextView
        android:id="@+id/tvVacio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Sin resultados"
        android:visibility="gone"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAnadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="Añadir Producto"
        app:backgroundTint="@color/verde_primario"
        app:elevation="8dp"
        app:srcCompat="@drawable/ic_anadir"
        app:tint="@color/blanco" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
</file>

<file path="app/src/main/res/layout/fragment_operaciones.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/blanco_semi">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Operaciones de Campo"
        android:textColor="@color/verde_oscuro"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardInventario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_inventario"
                android:background="@drawable/bg_icono_modulo"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inventario"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control de productos y stock"
                    android:textColor="@color/gris_hint"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardGestionAves"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_gallina"
                android:background="@drawable/bg_icono_modulo"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Aves"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitoreo y registro de galpones"
                    android:textColor="@color/gris_hint"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
</file>

<file path="app/src/main/res/layout/fragment_perfil.xml">
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_semi"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Avatar de Usuario -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_persona"
                app:strokeColor="@color/verde_suave"
                app:strokeWidth="4dp"
                app:shapeAppearanceOverlay="@style/Circle" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEditarFoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                app:fabCustomSize="40dp"
                app:elevation="4dp"
                app:srcCompat="@drawable/ic_editar_perfil"
                app:backgroundTint="@color/verde_primario"
                app:tint="@color/blanco"
                android:contentDescription="Editar foto"
                app:shapeAppearanceOverlay="@style/Circle" />
        </FrameLayout>

        <!-- Correo bajo el Avatar -->
        <TextView
            android:id="@+id/tvCorreoPerfilHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="usuario@correo.com"
            android:textColor="@color/verde_oscuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Tarjeta de Datos Personales -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información Personal"
                    android:textColor="@color/verde_oscuro"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Nombre Completo"
                    app:startIconDrawable="@drawable/ic_persona"
                    app:startIconTint="@color/verde_primario">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Rol en el Sistema"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:startIconTint="@color/verde_primario">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRolSistema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:enabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Ubicación / Sector"
                    app:startIconDrawable="@drawable/ic_buscar"
                    app:startIconTint="@color/verde_primario">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enfoque de Producción"
                    app:startIconDrawable="@drawable/ic_gallina"
                    app:startIconTint="@color/verde_primario">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEnfoqueProduccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón de Acción -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizarPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ACTUALIZAR PERFIL"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/verde_primario"
            android:textColor="@color/blanco"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
</file>

